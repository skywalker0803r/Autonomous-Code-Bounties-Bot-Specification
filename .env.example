# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username

# Logging
LOG_LEVEL=INFO

# PR Tracker (pr_tracker/) - optional. Only needed if you expose it beyond
# your own LAN (e.g. via a Cloudflare Tunnel); leave unset for LAN-only,
# no-login use.
PR_TRACKER_USERNAME=
PR_TRACKER_PASSWORD=

# Auto-populated by webapp/backend/store.py:sync_prs_gist() the first time
# it runs - the Gist id the docs/ (GitHub Pages) PR tracker syncs its
# tracked-PR list from. Leave unset; do not set this by hand.
PR_TRACKER_GIST_ID=
